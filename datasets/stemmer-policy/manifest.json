  "schema": {
    "format": "document",
    "fields": [
      "id",
      "name",
      "kind",
      "family",
      "languages",
      "best_for_domains",
      "notes",
      "license",
      "resource_ref",
      "scope",
      "target",
      "domain",
      "stemmer",
      "tokenizer",
      "code_tokenizer",
      "vocabulary",
      "rationale"
    ],
    "schema_uri": "./SCHEMA.md"
  },
  "lineage": {
    "transform": "Authored policy dataset (2026-08-02). stemmers.jsonl = curated catalog of AVAILABLE normalizers/tokenizers/vocabularies (Porter, Snowball/Porter2, Lancaster, Krovetz, spaCy lemmatizer, code-identifier + Unicode-word tokenizers, no-op normalizer; health terminologies SNOMED CT / MeSH / UMLS; legal + finance controlled term lists). assignment-policy.jsonl = one record per first-party ~/dev repo (121, canonical set = ds.ci-workflows-tests sources) plus a per-domain fallback, mapping each repo to a stemmer+tokenizer+code_tokenizer+vocabulary by DOMAIN inferred read-only from each repo's README. Licensed terminologies (SNOMED CT, UMLS) are captured as POINTER + license note ONLY; no terminology content is vendored. No client/competitor marketing materials.",
    "receipt_required": true,
    "upstream_datasets": [
      "ds.ci-workflows-tests"
    ]
  },
  "quality": {
    "checks": [
      "valid-jsonl-per-line (stemmers.jsonl, assignment-policy.jsonl)",
      "every stemmer record has id+name+kind+family",
      "every assignment record has id+scope+target+stemmer+tokenizer",
      "assignment stemmer/tokenizer/code_tokenizer/vocabulary reference an id in stemmers.jsonl (vocabulary may be null)",
      "scope in {repo,domain}; every repo assignment maps to a domain fallback",
      "health-domain repos => stemmer=stem.snowball AND vocabulary=vocab.snomed-ct AND code_tokenizer=tok.code-identifier",
      "licensed terminologies (SNOMED CT, UMLS) carry license note + resource_ref pointer, no vendored content",
      "first-party only; no client/competitor marketing materials"
    ],
    "minimum_quality_gate": "seed"
  },
  "access": {
    "visibility": "public",
    "owners": [
      "@mdheller"
    ],
    "allowed_roles": [
      "agent",
      "platform",
      "reviewer"
    ]
  }
