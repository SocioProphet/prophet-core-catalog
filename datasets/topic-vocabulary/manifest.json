  "schema": {
    "format": "mixed",
    "fields": [
      "coherence",
      "definition",
      "id",
      "kind",
      "name",
      "narrower_terms",
      "node",
      "rank",
      "related_terms",
      "repo",
      "repos",
      "scope",
      "source",
      "term",
      "top_terms",
      "topic_id",
      "weight"
    ],
    "schema_uri": "./SCHEMA.md"
  },
  "lineage": {
    "transform": "Read-only topic modelling of first-party ~/dev repos (2026-08-02). Per repo, a one-doc-per-file corpus (code+docs; identifiers split on camelCase/snake_case, lowercased, stopwords + language keywords + <=2-char tokens dropped) is modelled three ways: LSA (sklearn TruncatedSVD on TF-IDF), LSI (gensim LsiModel on the TF-IDF corpus; same latent-semantic family as LSA), and LDA (sklearn LatentDirichletAllocation on counts); k=10 topics, top 15 terms/topic. The repo vocabulary = union of top terms across its topics, each labelled by source model. combined-additive = set-union of every repo's per-method vocabulary with repo+method provenance (the blast-radius edge set). combined-natural = LSA/LSI/LDA re-run over the whole-estate pooled corpus. A glossary layer authors 1-sentence definitions for every topic and term and links them (skos:related/broader/narrower); emitted as glossary.jsonl, DataHub business_glossary.yml, and skos:definition-bearing turtle. First-party provider names in our own code are retained as our vocabulary; no client/competitor marketing materials were ingested.",
    "receipt_required": true,
    "upstream_datasets": []
  },
  "quality": {
    "checks": [
      "valid-jsonl-per-line (vocabulary.jsonl, topics.jsonl, glossary.jsonl)",
      "every vocabulary record has id+term+repo+source+scope",
      "source in {LSA,LSI,LDA}; scope in {repo,combined-additive,combined-natural}",
      "turtle parses via rdflib (all 131 graphs)",
      "glossary definitions present; turtle skos:definition parses",
      "business_glossary.yml parses as DataHub business-glossary v1",
      "first-party only; no client/competitor marketing materials"
    ],
    "minimum_quality_gate": "seed"
  },
  "access": {
    "visibility": "public",
    "owners": [
