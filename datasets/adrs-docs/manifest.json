  "schema": {
    "format": "document",
    "fields": [
      "adr_number",
      "date",
      "id",
      "intent",
      "kind",
      "path",
      "repo",
      "status",
      "superseded_by",
      "supersedes",
      "title"
    ],
    "schema_uri": "./SCHEMA.md"
  },
  "lineage": {
    "transform": "Read-only markdown harvest of first-party ~/dev repos (2026-08-02): 140 ADRs (**/ADR-*.md, **/adr/*.md, docs/adr/**, decisions/**, and files carrying an ADR status/front-matter) and 1000 key docs (top-level README.md + load-bearing docs/**/*.md matching a design/architecture/spec/governance/rfc signal filter, capped at 40 docs/repo). Skipped *.wt, _* dirs, node_modules/vendored, @-pinned and -main embedded third-party snapshots (e.g. gaia cv/sources ESIPFed), and ADR template files. Excluded AgenticaForge/agent-inbox (third-party). First-party only; no client/competitor materials.",
    "receipt_required": true,
    "upstream_datasets": []
  },
  "quality": {
    "checks": [
      "valid-jsonl-per-line",
      "every record has id",
      "adr status in {proposed,accepted,superseded,deprecated,rejected,unknown}",
      "doc kind in {readme,design,spec,governance,rfc,other}",
      "superseded/deprecated ADRs surfaced in README (still-present sweep)",
      "first-party only (vendored/@-pinned/-main snapshots pruned)"
    ],
    "minimum_quality_gate": "seed"
  },
  "access": {
    "visibility": "public",
    "owners": [
      "@mdheller"
    ],
    "allowed_roles": [
      "agent",
      "platform",
      "reviewer"
    ]
  }
