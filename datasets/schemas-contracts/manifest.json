  "schema": {
    "format": "document",
    "fields": [
      "id",
      "name",
      "kind",
      "repo",
      "path",
      "schema_id",
      "version",
      "consumers",
      "consumer_count",
      "intent"
    ],
    "schema_uri": "./SCHEMA.md"
  },
  "lineage": {
    "transform": "Read-only file-type harvest of first-party ~/dev repos (2026-08-02): JSON Schema (*.schema.json + $schema/$id-bearing *.json), Protobuf (*.proto), Avro (*.avsc), OpenAPI/AsyncAPI (openapi*/asyncapi*), SHACL (*.shacl.ttl), and clearly-contract TS/Zod/Pydantic modules under contracts/ dirs. Duplicate working copies (*-chronos-superset, *-kairos-draft, prophet-platform branch clones) and third-party trees (AgenticaForge, agent-inbox) excluded. consumers[] are best-effort $ref/import blast-radius edges resolved by basename/$id across the same repo set.",
    "receipt_required": true,
    "upstream_datasets": []
  },
  "quality": {
    "checks": [
      "valid-jsonl-per-line",
      "every record has id+kind+repo+path",
      "kind in {json-schema,protobuf,shacl,openapi,avro,other}",
      "sources[] resolve to registered catalog sources (referential integrity)",
      "consumers[] are best-effort blast-radius edges (basename/$id match)",
      "unversioned contracts surfaced for governance (no silent version)"
    ],
    "minimum_quality_gate": "seed"
  },
  "access": {
    "visibility": "public",
    "owners": [
      "@mdheller"
    ],
    "allowed_roles": [
      "agent",
      "platform",
      "reviewer"
    ]
  }
}
