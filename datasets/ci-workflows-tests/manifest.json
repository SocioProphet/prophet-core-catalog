  "schema": {
    "format": "document",
    "fields": [
      "id",
      "repo",
      "path",
      "type",
      "name",
      "triggers",
      "jobs",
      "gating",
      "fail_open_signals",
      "last_status",
      "framework",
      "test_count",
      "file_count",
      "tested_target"
    ],
    "schema_uri": "./SCHEMA.md"
  },
  "lineage": {
    "transform": "Read-only os.walk + PyYAML/regex harvest of 149 first-party ~/dev repos (2026-08-02). Skipped *.wt worktrees, _*-prefixed dirs, and node_modules/target/dist/build/vendor/.venv/coverage/site-packages trees. ci-workflows.jsonl = one record per CI asset (.github/workflows/*.yml|yaml, Makefile/*.mk *-ci|test|lint|check|validate targets, .gitlab-ci.yml, justfile, Taskfile). tests.jsonl = one record per (repo,dir,framework) test suite with an approximate test_count (def test_ / it(|test( / #[test] / func Test). last_status populated for a 16-repo active-org sample via `gh run list` (latest run per workflow name); null elsewhere (not queried). Third-party AgenticaForge and agent-inbox EXCLUDED per estate boundary. No client/competitor materials.",
    "receipt_required": true,
    "upstream_datasets": []
  },
  "quality": {
    "checks": [
      "valid-jsonl-per-line",
      "every ci record has id+repo+path+type",
      "every test record has id+repo+path+framework",
      "gating is boolean (pull_request/merge_group => true)",
      "test_count is approximate (heuristic pattern count, not runtime collection)",
      "first-party only (AgenticaForge/agent-inbox excluded)"
    ],
    "minimum_quality_gate": "seed"
  },
  "access": {
    "visibility": "public",
    "owners": [
