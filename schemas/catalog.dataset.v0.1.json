{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.ai/catalog/dataset.v0.1.json",
  "title": "Catalog Dataset Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "sources", "schema", "lineage", "quality", "access"],
  "properties": {
    "id": {"type": "string", "pattern": "^ds\\.[a-z0-9][a-z0-9_.-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^src\\."}},
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "fields"],
      "properties": {
        "format": {"enum": ["table", "document", "graph", "raster", "vector", "timeseries", "mixed"]},
        "fields": {"type": "array", "items": {"type": "string"}},
        "schema_uri": {"type": "string"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transform", "receipt_required"],
      "properties": {
        "transform": {"type": "string", "minLength": 1},
        "receipt_required": {"type": "boolean"},
        "upstream_datasets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {"type": "array", "items": {"type": "string"}},
        "minimum_quality_gate": {"type": "string"}
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "owners"],
      "properties": {
        "visibility": {"enum": ["public", "organization", "workspace", "restricted", "private"]},
        "owners": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "allowed_roles": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
